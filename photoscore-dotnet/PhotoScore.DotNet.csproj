<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PhotoScore.DotNet</RootNamespace>
    <AssemblyName>PhotoScore.DotNet</AssemblyName>
    <PackageId>PhotoScore.DotNet</PackageId>
    <Version>0.1.0</Version>
    <Authors>GtTmy</Authors>
    <Description>Local photo aesthetic scoring CLI and worker for AvaloniaPictureViewer.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>score-photo</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="models/aesthetic-score.onnx" CopyToOutputDirectory="PreserveNewest" Pack="false" Condition="Exists('models/aesthetic-score.onnx')" />
    <None Include="models/aesthetic-score.onnx.data" CopyToOutputDirectory="PreserveNewest" Pack="false" Condition="Exists('models/aesthetic-score.onnx.data')" />
  </ItemGroup>
</Project>
