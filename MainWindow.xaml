<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:apv="clr-namespace:AvaloniaPictureViewer"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="AvaloniaPictureViewer.MainWindow"
        x:CompileBindings="False"
        FontFamily="Noto Sans CJK JP, Segoe UI, Lucida Grande, Ubuntu"
        MinWidth="900"
        MinHeight="560"
        Width="1280"
        Height="760"
        Background="#0D1016"
        Title="{Binding Title}">
  <Window.Resources>
    <apv:PathToIBitmapConverter x:Key="PathToIBitMapConverter"/>
    <apv:PathToFilenameConverter x:Key="PathToFilenameConverter"/>
  </Window.Resources>
  <Window.KeyBindings>
    <KeyBinding Command="{Binding NextPageCommand}" Gesture="Right"/>
    <KeyBinding Command="{Binding PrevPageCommand}" Gesture="Left"/>
  </Window.KeyBindings>

  <Grid ColumnDefinitions="220,*,280">
    <Border Grid.Column="0"
            Background="#141821"
            BorderBrush="#252B37"
            BorderThickness="0,0,1,0"
            Padding="14">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Spacing="3" Margin="4,4,4,16">
          <TextBlock Text="LIBRARY" Foreground="#7C8CFF" FontWeight="SemiBold"
                     FontSize="11" LetterSpacing="1.4"/>
          <TextBlock Text="{Binding FolderName}" Foreground="#F2F4F8"
                     FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C222D" CornerRadius="8"
                Padding="10,7" Margin="0,0,0,12">
          <TextBlock Text="{Binding PageNum}" Foreground="#AEB7C7"
                     HorizontalAlignment="Center" FontSize="12"/>
        </Border>

        <Border Grid.Row="2" Background="#1C222D" CornerRadius="8"
                Padding="9" Margin="0,0,0,12">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="SORT BY" Foreground="#697386" FontSize="9"
                         LetterSpacing="1" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding SortStatus}" Foreground="#8E99AA"
                         FontSize="9" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,78" ColumnSpacing="6">
              <ComboBox ItemsSource="{Binding SortFields}"
                        SelectedItem="{Binding SelectedSortField, Mode=TwoWay}"
                        FontSize="11"/>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding SortDirections}"
                        SelectedItem="{Binding SelectedSortDirection, Mode=TwoWay}"
                        FontSize="11"/>
            </Grid>
          </StackPanel>
        </Border>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Pictures}"
                 SelectedItem="{Binding SelectedPicture, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="7" Background="#202632" Padding="5" Margin="0,0,0,8">
                <Grid RowDefinitions="92,Auto">
                  <Border Background="#0B0E13" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding Path, Converter={StaticResource PathToIBitMapConverter}, ConverterParameter=180}"
                             Stretch="UniformToFill"/>
                      <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="7"
                                Background="#151A23"/>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="3,7,3,2">
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" Foreground="#B8C0CE"
                                 FontSize="11" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding LastModifiedText}" Foreground="#697386"
                                 FontSize="9" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#151A23" CornerRadius="5"
                            Padding="6,3" VerticalAlignment="Center" Margin="5,0,0,0">
                      <TextBlock Text="{Binding ScoreText}" Foreground="#AAB4FF"
                                 FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="4" Background="#1C222D" CornerRadius="9" Padding="12" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="CHECKED" Foreground="#697386" FontSize="9" LetterSpacing="1"/>
              <TextBlock Text="{Binding CheckedCountText}" Foreground="#E1E5ED"
                         FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Copy"
                    Click="CopyCheckedFiles"
                    Background="#7C8CFF"
                    Foreground="#0D1016"
                    FontWeight="SemiBold"
                    CornerRadius="6"
                    Padding="13,7"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Background="#0D1016">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,18">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding FileName}" Foreground="#F4F6FA" FontSize="16"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="PHOTO PREVIEW" Foreground="#697386" FontSize="10" LetterSpacing="1.2"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#182030" BorderBrush="#2B3850"
                BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding PageNum}" Foreground="#C5CCDA" FontSize="12"/>
        </Border>
      </Grid>

      <Border Grid.Row="1" Margin="24,0" Background="#080A0E" BorderBrush="#202632"
              BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid>
          <Image Source="{Binding PicturePath, Converter={StaticResource PathToIBitMapConverter}}"
                 Stretch="Uniform" Margin="12"/>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="#DD141821" CornerRadius="8" Margin="18" Padding="12,8">
            <CheckBox IsChecked="{Binding SelectedPicture.IsChecked, Mode=TwoWay}"
                      Content="この画像をチェック"
                      Foreground="#F2F4F8"
                      FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="24,16,24,20">
        <Button Grid.Column="0" Command="{Binding PrevPageCommand}" Content="&lt;  Previous"
                HorizontalAlignment="Left" Background="#1B212C" Foreground="#D7DCE6"
                Padding="18,9" CornerRadius="7"/>
        <TextBlock Grid.Column="1" Text="Use left and right arrow keys to browse"
                   Foreground="#687284" FontSize="11" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Command="{Binding NextPageCommand}" Content="Next  &gt;"
                HorizontalAlignment="Right" Background="#7C8CFF" Foreground="#0D1016"
                Padding="22,9" CornerRadius="7" FontWeight="SemiBold"/>
      </Grid>
    </Grid>

    <Border Grid.Column="2" Background="#141821" BorderBrush="#252B37"
            BorderThickness="1,0,0,0" Padding="20">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
        <StackPanel Spacing="3" Margin="2,4,2,0">
          <TextBlock Text="DETAILS" Foreground="#7C8CFF" FontWeight="SemiBold"
                     FontSize="11" LetterSpacing="1.4"/>
          <TextBlock Text="Photo insights" Foreground="#F2F4F8" FontSize="17" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Background="#1C222D" BorderBrush="#293241" BorderThickness="1"
                CornerRadius="12" Padding="18">
          <StackPanel Spacing="6">
            <TextBlock Text="AESTHETIC SCORE" Foreground="#8E99AA" FontSize="10" LetterSpacing="1.1"/>
            <TextBlock Text="{Binding ScoreValue}" Foreground="#AAB4FF" FontSize="42" FontWeight="Bold"/>
            <Border Height="5" Background="#293142" CornerRadius="3" Margin="0,4,0,2">
              <Border Width="116" Background="#7C8CFF" CornerRadius="3" HorizontalAlignment="Left"/>
            </Border>
            <TextBlock Text="{Binding ScoreText}" Foreground="#8E99AA" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10">
          <TextBlock Text="FILE INFORMATION" Foreground="#697386" FontSize="10"
                     LetterSpacing="1.1" Margin="2,0,0,2"/>
          <Border Background="#1A1F29" CornerRadius="8" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Filename" Foreground="#697386" FontSize="10"/>
              <TextBlock Text="{Binding FileName}" Foreground="#DDE2EA" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="#1A1F29" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Folder" Foreground="#697386" FontSize="10"/>
                <TextBlock Text="{Binding FolderName}" Foreground="#DDE2EA"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                <TextBlock Text="Size" Foreground="#697386" FontSize="10"/>
                <TextBlock Text="{Binding FileSizeText}" Foreground="#DDE2EA" FontSize="12"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <Border Background="#1C222D" BorderBrush="#293241" BorderThickness="1"
                CornerRadius="10" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="FINDER COPY" Foreground="#8E99AA" FontSize="10" LetterSpacing="1"/>
                <TextBlock Text="{Binding CheckedCountText}" Foreground="#E5E8EF"
                           FontWeight="SemiBold" FontSize="14"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Copy files"
                      Click="CopyCheckedFiles"
                      Background="#7C8CFF"
                      Foreground="#0D1016"
                      FontWeight="SemiBold"
                      CornerRadius="7"
                      Padding="14,8"/>
            </Grid>
            <TextBlock Text="{Binding ClipboardStatus}" Foreground="#8E99AA"
                       FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
