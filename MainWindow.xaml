<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:apv="clr-namespace:AvaloniaPictureViewer"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaPictureViewer.MainWindow"
        x:CompileBindings="False"
        FontFamily="Noto Sans CJK JP, Segoe UI, Lucida Grande, Ubuntu"
        Title="{Binding Title.Value}">
  <Window.Resources>
    <apv:PathToIBitmapConverter x:Key="PathToIBitMapConverter"/>
  </Window.Resources>
  <Window.KeyBindings>
    <KeyBinding Command="{Binding NextPageCommand}" Gesture="Right"/>
    <KeyBinding Command="{Binding PrevPageCommand}" Gesture="Left"/>
  </Window.KeyBindings>
  <Grid RowDefinitions="*,32">
    <Image Grid.Row="0"
           Source="{Binding PicturePath.Value, Converter={StaticResource PathToIBitMapConverter}}"
           Stretch="Uniform"/>
    <Border Grid.Row="1"
            Background="#202225"
            BorderBrush="#34373B"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding ScoreText}"
                 Foreground="#E7E9EC"
                 FontSize="13"
                 VerticalAlignment="Center"
                 Margin="12,0"
                 TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
